<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Row 1: big TextView + flag on the right -->
    <TextView
        android:id="@+id/text_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/label_title"
        android:textSize="30dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/image_flag"
        android:layout_marginEnd="8dp" />

    <ImageButton
        android:id="@+id/image_flag"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_flag_button"
        android:scaleType="centerCrop"
        android:src="@drawable/flag"
        app:layout_constraintTop_toTopOf="@id/text_title"
        app:layout_constraintBottom_toBottomOf="@id/text_title"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Row 2: Switch -->
    <Switch
        android:id="@+id/switch1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/switch_label"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/text_title"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Row 3: Button + Checkbox on same row -->
    <Button
        android:id="@+id/button_press"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/button_press_me"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/switch1"
        app:layout_constraintStart_toStartOf="parent" />

    <CheckBox
        android:id="@+id/checkbox1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/checkbox_label"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/button_press"
        app:layout_constraintTop_toTopOf="@id/button_press" />

    <!-- Row 4: EditText full width -->
    <EditText
        android:id="@+id/edit_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/hint_love_android"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/button_press"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
